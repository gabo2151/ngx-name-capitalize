{
  "name": "ngx-name-capitalize-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for the ngx-name-capitalize library, Angular 12 – 13 line. The published manifest lives in projects/ngx-name-capitalize/package.json.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "build": "npm run readme:sync && ng build ngx-name-capitalize",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit -p projects/ngx-name-capitalize/tsconfig.spec.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "readme:sync": "node scripts/sync-readme.mjs",
    "readme:check": "node scripts/sync-readme.mjs --check",
    "verify": "npm run lint && npm run readme:check && npm run typecheck && npm test",
    "compat": "node scripts/verify-angular-compat.mjs"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~12.2.18",
    "@angular/cli": "~12.2.18",
    "@angular/common": "~12.2.0",
    "@angular/compiler": "~12.2.0",
    "@angular/compiler-cli": "~12.2.0",
    "@angular/core": "~12.2.0",
    "@angular/platform-browser": "~12.2.0",
    "@angular/platform-browser-dynamic": "~12.2.0",
    "@babel/core": "^7.24.0",
    "@biomejs/biome": "2.5.13",
    "@types/jest": "^28.1.8",
    "jest": "^28.1.3",
    "jest-preset-angular": "^12.2.6",
    "name-capitalize": "^1.4.0",
    "ng-packagr": "^12.1.1",
    "rxjs": "~6.6.0",
    "tslib": "^2.3.0",
    "typescript": "~4.3.5",
    "zone.js": "~0.11.4"
  }
}
