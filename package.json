{
  "name": "ngx-name-capitalize-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for the ngx-name-capitalize library, Angular 14 – 15 line. The published manifest lives in projects/ngx-name-capitalize/package.json.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "build": "npm run readme:sync && ng build ngx-name-capitalize",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit -p projects/ngx-name-capitalize/tsconfig.spec.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "readme:sync": "node scripts/sync-readme.mjs",
    "readme:check": "node scripts/sync-readme.mjs --check",
    "verify": "npm run lint && npm run readme:check && npm run typecheck && npm test",
    "compat": "node scripts/verify-angular-compat.mjs"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~14.0.0",
    "@angular/cli": "~14.0.0",
    "@angular/common": "~14.0.0",
    "@angular/compiler": "~14.0.0",
    "@angular/compiler-cli": "~14.0.0",
    "@angular/core": "~14.0.0",
    "@angular/platform-browser": "~14.0.0",
    "@angular/platform-browser-dynamic": "~14.0.0",
    "@babel/core": "^7.24.0",
    "@biomejs/biome": "2.5.13",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-preset-angular": "^13.1.6",
    "name-capitalize": "^2.3.0",
    "ng-packagr": "^14.0.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "typescript": "~4.7.0",
    "zone.js": "~0.11.4"
  }
}
